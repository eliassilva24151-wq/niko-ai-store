# ============================================
# CONFIGURAÇÃO DO BANCO DE DADOS
# ============================================
# Use o banco da HostGator ou crie um gratuito no PlanetScale
DATABASE_URL=mysql://usuario:senha@localhost:3306/nome_do_banco

# ============================================
# SEGURANÇA
# ============================================
# Crie um segredo aleatório (mínimo 32 caracteres)
JWT_SECRET=meu-segredo-super-seguro-123456789-abcdef

# ============================================
# APP
# ============================================
VITE_APP_ID=niko-ai-store
NODE_ENV=production

# ============================================
# OAUTH (Opcional - deixe vazio por enquanto)
# ============================================
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# ============================================
# PAGAMENTOS (Opcional - deixe vazio por enquanto)
# ============================================
ATLAS_API_KEY=
DEPIX_WALLET_ADDRESS=

# ============================================
# ANALYTICS (Opcional)
# ============================================
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
